sentinel_word = "" # Sentinel value for an empty word (end of input)
word_count = 0

# Get words until the sentinel value is entered
word = input("Enter a word (or press Enter to end): ")
while word != sentinel_word:
	word_count += 1

	# Get the next word (or sentinel)
	word = input("Enter a word (or press Enter to end): ")
	
print(f"The total number of words entered is: {word_count}")
